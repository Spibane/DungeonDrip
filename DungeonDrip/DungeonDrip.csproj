<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.17.2.0</Version>
    <Description>Shows which drip you are still missing from your Glamour Dresser and Armoire, wherever the game shows you gear.</Description>
    <PackageProjectUrl>https://github.com/Spibane/DungeonDrip</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Copyright (C) 2026 Spibane</Copyright>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    KamiToolKit builds the plugin's native game windows. A submodule pinned by commit, because it
    publishes no releases and no package; see the readme on why that is the accepted arrangement and
    what happens if it stops being maintained. MIT, so its notice ships in THIRD-PARTY-NOTICES.md.

    CARRIES A LOCAL PATCH, AND THE PIN IS NOT A COMMIT ANYONE ELSE HAS. One commit on top of
    upstream's master exposes CollapsingHeaderNode's label so the native panels can colour their
    group headings; without it those headings are dark text on a dark bar under the light themes.

    Two consequences, both live:

    - A fresh clone cannot resolve the submodule, so CI will fail on any push until the pin points
      at a commit that exists on a remote. The patch is in the local clone only.
    - Nothing has been pushed to, forked from, or filed against the upstream repository, and nothing
      should be without asking. The change is written to be offerable upstream, but offering it is a
      decision rather than a step.
  -->
  <ItemGroup>
    <ProjectReference Include="..\external\KamiToolKit\KamiToolKit.csproj" />
  </ItemGroup>
</Project>
