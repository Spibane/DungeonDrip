<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.18.0.0</Version>
    <Description>Shows which drip you are still missing from your Glamour Dresser and Armoire, wherever the game shows you gear.</Description>
    <PackageProjectUrl>https://github.com/Spibane/DungeonDrip</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Copyright (C) 2026 Spibane</Copyright>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    KamiToolKit builds the plugin's native game windows. A submodule pinned by commit, because it
    publishes no releases and no package; see the readme on why that is the accepted arrangement and
    what happens if it stops being maintained. MIT, so its notice ships in THIRD-PARTY-NOTICES.md.

    Pinned to a commit on upstream's own master and kept that way deliberately. A local patch was
    tried, to expose the header label the native panels want to recolour, and reverted: it pins the
    submodule to a commit no other clone can fetch, so every build but this one fails. A wrong
    colour on two themes is the cheaper of the two. See NativeRenderer's collapsible.
  -->
  <ItemGroup>
    <ProjectReference Include="..\external\KamiToolKit\KamiToolKit.csproj" />
  </ItemGroup>
</Project>
